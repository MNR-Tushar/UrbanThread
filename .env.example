# ─── Django Core Settings ───────────────────────────────────────────────────────
SECRET_KEY=your-secure-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://urbanthreadshop.vercel.app

# ─── Database Configuration ──────────────────────────────────────────────────
# Default is SQLite for local development without Docker:
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# For PostgreSQL / Docker (uncomment when using Postgres):
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=urbanthread
# DB_USER=postgres
# DB_PASSWORD=your-postgres-password
# DB_HOST=localhost
# DB_PORT=5432

# Or use hosted DATABASE_URL (Supabase / Render):
# DATABASE_URL=postgres://user:password@hostname:5432/dbname

# ─── Redis & Caching ─────────────────────────────────────────────────────────
# Use 'locmem' for local dev without a running Redis server.
# For Redis / Docker, use redis://localhost:6379/0 or redis://redis:6379/0
REDIS_URL=locmem
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ─── Frontend & Public URLs ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://127.0.0.1:8000

# ─── Authentication & OAuth ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# ─── AI Customer Support Chatbot ─────────────────────────────────────────────
# Provider choice: 'gemini' (free tier recommended) or 'openai'
CHATBOT_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_CHAT_MODEL=gemini-3.8-flash
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_CHAT_MODEL=gpt-4o-mini

# ─── Payment Gateway (SSLCommerz) ────────────────────────────────────────────
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_SANDBOX=True

# ─── Cloudinary Media Storage (Optional) ──────────────────────────────────────
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_URL=cloudinary://123456789:abcdefghijk@mycloud

# ─── Email Configuration (Brevo / SendGrid / SMTP) ───────────────────────────
# Brevo (Recommended):
# BREVO_API_KEY=xkeysib-your-brevo-api-key
# BREVO_SENDER_EMAIL=verified-sender@your-domain.com
# BREVO_SENDER_NAME=UrbanThread

# SendGrid (Alternative):
# SENDGRID_API_KEY=SG.your-sendgrid-api-key

# Console Email fallback (default for local dev):
DEFAULT_FROM_EMAIL=noreply@urbanthread.com

# ─── Phone OTP SMS Provider (Optional) ───────────────────────────────────────
# SMS_API_URL=https://your-sms-provider.example/send
# SMS_API_TOKEN=your-sms-api-token
# SMS_SENDER_ID=UrbanThread
